{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purgo",
  "version": "1.0.1",
  "identifier": "com.tototra.purgo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Purgo",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Nettoyage, optimisation et outils développeurs",
    "longDescription": "Purgo nettoie, protège et accélère ton ordinateur : caches, confidentialité, désinstallation, doublons, environnements Python, node_modules, Docker, modèles d'IA et plus encore.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
